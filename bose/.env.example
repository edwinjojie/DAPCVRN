# ──────────────────────────────────────────────────────────────────────────────
# BOSE Unified Backend – Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB (Docker) ──────────────────────────────────────────────────────────
# Docker MongoDB running via docker-compose (see bose/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/mydatabase
MONGO_URI=mongodb://localhost:27017/mydatabase

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development


# ── Hyperledger Fabric ────────────────────────────────────────────────────────
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE_ID=bose
FABRIC_MSP=Org1MSP
FABRIC_AFFILIATION=org1.department1
# Optional: override the connection profile path (defaults to blockchain-services-new path)
# FABRIC_CCP_PATH=/absolute/path/to/connection-org1.json

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30000
